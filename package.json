{
  "name": "dsh-science",
  "version": "0.14.0",
  "description": "Scientific workbench for DeepSeek Harness: publication figures, database connections, auto result review, SSH remote compute",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "agents",
    "client",
    "skills",
    "locale",
    "assets",
    "cordis.patch.yml",
    "icon.svg",
    "docs"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "scripts": {
    "test": "node --test tests/unit.test.mjs",
    "build:client": "node scripts/build-client.mjs"
  },
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "0.2.2-rc.1",
    "mysql2": "^3.24.6",
    "postgres": "^4.1.0"
  },
  "devDependencies": {
    "esbuild": "0.25.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
