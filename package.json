{
  "name": "dsh-science",
  "version": "0.10.1",
  "description": "Scientific workbench for DeepSeek Harness: publication figures, database connections, auto result review, SSH remote compute",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "agents",
    "client",
    "skills",
    "locale",
    "assets",
    "cordis.patch.yml",
    "icon.svg",
    "docs",
    "HANDOFF.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "scripts": {
    "build:client": "npx -y esbuild@0.25.0 --version >/dev/null 2>&1 && node scripts/build-client.mjs || (npm i --no-save esbuild@^0.25.0 --no-fund --no-audit && node scripts/build-client.mjs)"
  },
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "0.2.2-rc.1",
    "mysql2": "^3.24.6",
    "postgres": "^4.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}